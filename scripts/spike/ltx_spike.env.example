# Copy to scripts/spike/ltx_spike.env (git-ignored) and edit.
# Values marked VERIFY must be checked against the official Lightricks pages before use (spec §7, §78).

# NGC PyTorch image with arm64 + GB10 support. Must match the one verify_gx10.sh passed with.
NGC_IMAGE=nvcr.io/nvidia/pytorch:25.11-py3

# Where weights, sources and outputs live on the GX10.
DATA_ROOT=/data

# Official source code. Pin LTX_GIT_REF to a commit or tag once the first run succeeds.
LTX_GIT_URL=https://github.com/Lightricks/LTX-2.git
LTX_GIT_REF=main

# Official weights (VERIFY the repo id on https://huggingface.co/Lightricks).
LTX_HF_REPO=Lightricks/LTX-2.3
# Space-separated glob patterns. Run `ltx_spike.sh list-files` first and pick ONLY what the spike needs
# (e.g. the distilled checkpoint + spatial upscaler), not every variant; each checkpoint is tens of GB.
LTX_HF_INCLUDE=""

# Text encoder named in the LTX README (VERIFY). It may be a gated repo: accept its license on
# huggingface.co and set HF_TOKEN. Leave empty if the LTX repo already bundles it.
TEXT_ENCODER_HF_REPO=""
TEXT_ENCODER_HF_INCLUDE=""

# Hugging Face token (download step only; runtime runs with no network).
HF_TOKEN=

# Spike input. Do NOT use an employee photo until consent records exist (ADR-012):
# use an object/landscape image or a photo of yourself.
SPIKE_INPUT_IMAGE=/data/spike/input/keyframe.png
SPIKE_PROMPT="A slow dolly shot toward a wooden desk in a modern office, warm daylight through a large window, cinematic, realistic."

# Pipeline command, filled in AFTER `ltx_spike.sh discover` shows the real module names and flags.
# It runs inside the container with bash. These variables are available:
#   $MODELS_DIR (=/models)  $INPUT_IMAGE  $OUTPUT_DIR (=/spike/output/<run>)  $PROMPT
# Example SHAPE only (module name and flags are placeholders until discover confirms them):
#   LTX_RUN_CMD='python -m <pipeline_module> --checkpoint-path $MODELS_DIR/... --image $INPUT_IMAGE --prompt "$PROMPT" --output-path $OUTPUT_DIR/out.mp4'
LTX_RUN_CMD=''

# Number of measured runs (run 1 includes cold weight loading from disk).
LTX_RUNS=2
