# Copy to .env and fill in. Spec §55, amended by review 01 (C4: ComfyUI inside/next to ai-engine, C5: llm service)
# and ADR-013 (the existing ComfyUI on the GX10 is used as an external service during the MVP).
# Never commit .env. Values shown are defaults or placeholders.
# Keep comments on their own lines: after an empty value, a trailing "# ..." would be read as the value.

# development | test | production
APP_ENV=production
LOG_LEVEL=INFO
LOG_JSON=true

DATABASE_URL=postgresql://yas:CHANGE_ME@postgres:5432/yas
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME

LOCAL_LLM_BASE_URL=http://llm:11434
LOCAL_LLM_MODEL=
# MVP: the GX10's existing ComfyUI, e.g. http://gx10-67e1:8188
COMFYUI_URL=http://ai-engine:8188

DEFAULT_VIDEO_PROVIDER=ltx
DEFAULT_VIDEO_MODEL=ltx-2.3
# Spec §56: one video job at a time on the GX10
MAX_CONCURRENT_VIDEO_JOBS=1
DEFAULT_VIDEO_RESOLUTION=1080p
DEFAULT_VIDEO_DURATION=6

# Egress policy (spec §38, §73). Offline by default: only the services above are reachable.
# offline | online
NETWORK_MODE=offline
# true requires NETWORK_MODE=online and a non-empty ALLOWED_EXTERNAL_HOSTS
ENABLE_EXTERNAL_APIS=false
# Comma-separated external host names, e.g. huggingface.co
ALLOWED_EXTERNAL_HOSTS=
# Other office-LAN services the backend may call, comma-separated
EXTRA_INTERNAL_HOSTS=
