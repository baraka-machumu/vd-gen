# Copy to .env (repo root) and fill in. Spec §55, amended by review 01 (C4, C5), ADR-013 (existing ComfyUI on the
# GX10 during the MVP) and ADR-015 (SeaweedFS as the S3-compatible object store, S3_* instead of MINIO_*).
# Never commit .env. Values shown are defaults or placeholders; replace every CHANGE_ME.
# Keep comments on their own lines: after an empty value, a trailing "# ..." would be read as the value.

# ---- Compose only (docker-compose.yml builds the service URLs from these) ----
POSTGRES_USER=yas
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=yas
REDIS_PASSWORD=CHANGE_ME
# nginx is the only published port. Bind to the office-LAN address of the host, never 0.0.0.0 on a public host.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# ---- Application (backend/app/core/config.py) ----
# development | test | production
APP_ENV=production
LOG_LEVEL=INFO
LOG_JSON=true

# Used when the API runs outside compose; inside compose DATABASE_URL and REDIS_URL are built from the values above.
DATABASE_URL=postgresql://yas:CHANGE_ME@localhost:5432/yas
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
S3_ENDPOINT=seaweedfs:8333
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

LOCAL_LLM_BASE_URL=http://llm:11434
LOCAL_LLM_MODEL=
# MVP: the GX10's existing ComfyUI. Same host as compose: http://host.docker.internal:8188
COMFYUI_URL=http://host.docker.internal:8188

DEFAULT_VIDEO_PROVIDER=ltx
DEFAULT_VIDEO_MODEL=ltx-2.3
# Spec §56: one video job at a time on the GX10
MAX_CONCURRENT_VIDEO_JOBS=1
DEFAULT_VIDEO_RESOLUTION=1080p
DEFAULT_VIDEO_DURATION=6

# Egress policy (spec §38, §73). Offline by default: only the platform's own services are reachable.
# offline | online
NETWORK_MODE=offline
# true requires NETWORK_MODE=online and a non-empty ALLOWED_EXTERNAL_HOSTS
ENABLE_EXTERNAL_APIS=false
# Comma-separated external host names, e.g. huggingface.co
ALLOWED_EXTERNAL_HOSTS=
# Other office-LAN services the backend may call, comma-separated
EXTRA_INTERNAL_HOSTS=
